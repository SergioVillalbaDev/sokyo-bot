# --- Configuración del bot Sokyo ---

# Cadena de conexión a MongoDB
MONGO_URI=mongodb://localhost:27017/sokyo

# Token del bot de Discord (Developer Portal -> Bot -> Token)
DISCORD_TOKEN=tu_token_de_discord

# Puerto en el que escucha la API (por defecto 3000)
PORT=3000

# --- Login con Discord (OAuth2) ---
# El panel de staff y el portal de clientes entran con Discord. En el Developer Portal -> tu app -> OAuth2:
# copia el Client ID y el Client Secret y añade ESTAS DOS Redirect URIs (exactas) a la lista de redirects.
DISCORD_CLIENT_ID=tu_client_id_de_discord
DISCORD_CLIENT_SECRET=tu_client_secret_de_discord
# Panel de staff
OAUTH_STAFF_REDIRECT_URI=http://localhost:3000/api/auth/staff/callback
# Portal de clientes
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# URL del panel/portal web (a donde se vuelve tras el login)
FRONTEND_URL=http://localhost:5173

# Secreto para firmar las sesiones (OBLIGATORIO en producción: cualquier cadena larga y aleatoria).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si falta, se usa uno aleatorio y todas las sesiones se cierran al reiniciar el bot.
JWT_SECRET=cambia-este-secreto-de-sesion
