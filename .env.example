# --- Configuración del bot Sokyo ---

# Cadena de conexión a MongoDB
MONGO_URI=mongodb://localhost:27017/sokyo

# Token del bot de Discord (Developer Portal -> Bot -> Token)
DISCORD_TOKEN=tu_token_de_discord

# Puerto en el que escucha la API (por defecto 3000)
PORT=3000

# Clave de acceso al panel de staff (OBLIGATORIA, mínimo 16 caracteres). El bot NO arranca sin ella.
# Se escribe en la pantalla de login del panel; ya NO se pone en el frontend.
# Genérala con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# --- Portal del Cliente (login con Discord / OAuth2) ---
# En el Developer Portal -> tu app -> OAuth2: copia el Client ID y el Client Secret,
# y añade la Redirect URI EXACTA (la de abajo) en la lista de redirects de OAuth2.
DISCORD_CLIENT_ID=tu_client_id_de_discord
DISCORD_CLIENT_SECRET=tu_client_secret_de_discord
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# URL del panel/portal web (a donde se vuelve tras el login)
FRONTEND_URL=http://localhost:5173

# Secreto para firmar las sesiones (OBLIGATORIO, mínimo 16 caracteres y DISTINTO de API_KEY).
JWT_SECRET=

# --- Opcionales ---
# Orígenes extra (separados por comas) desde los que el panel puede llamar a la API, p. ej. tu dominio de Vercel.
# FRONTEND_URL ya está permitido automáticamente.
# CORS_ORIGINS=https://mi-panel.vercel.app

# Si el bot está detrás de un proxy/Nginx, indica cuántos proxies (p. ej. 1) para que el límite de peticiones use la IP real.
# TRUST_PROXY=1

# Días que se conservan los logs de auditoría (por defecto 90; 0 = no borrar nunca).
# LOG_RETENTION_DAYS=90
