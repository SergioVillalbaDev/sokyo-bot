# --- Configuración del bot Sokyo ---

# Cadena de conexión a MongoDB
MONGO_URI=mongodb://localhost:27017/sokyo

# Token del bot de Discord (Developer Portal -> Bot -> Token)
DISCORD_TOKEN=tu_token_de_discord

# Puerto en el que escucha la API (por defecto 3000)
PORT=3000

# Si despliegas detrás de un proxy/HTTPS (Nginx, Cloudflare, Render…), pon el número
# de saltos de proxy (normalmente 1) para que el límite de peticiones lea la IP real.
# En local, déjalo vacío.
TRUST_PROXY=

# Clave de la API. Si se define, todas las rutas /api (excepto /api/estado)
# exigen la cabecera "x-api-key" con este valor. DEBE coincidir con VITE_API_KEY
# del panel frontend. Déjala vacía solo en desarrollo local.
API_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# --- Portal del Cliente (login con Discord / OAuth2) ---
# En el Developer Portal -> tu app -> OAuth2: copia el Client ID y el Client Secret,
# y añade la Redirect URI EXACTA (la de abajo) en la lista de redirects de OAuth2.
DISCORD_CLIENT_ID=tu_client_id_de_discord
DISCORD_CLIENT_SECRET=tu_client_secret_de_discord
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# URL del panel/portal web (a donde se vuelve tras el login)
FRONTEND_URL=http://localhost:5173

# Secreto para firmar las sesiones del portal (cualquier cadena larga y aleatoria).
# Si se deja vacío, se usa API_KEY.
JWT_SECRET=cambia-este-secreto-de-sesion

# --- PROPIETARIO(S) ---
# IDs de Discord (separados por comas) que, al iniciar sesión en el panel,
# ven ABSOLUTAMENTE TODO: todos los servidores y todos los tickets, sin filtros.
# Para sacar tu ID: en Discord activa Ajustes -> Avanzado -> Modo desarrollador,
# clic derecho sobre tu nombre -> "Copiar ID de usuario".
OWNER_IDS=tu_id_de_discord

# --- DIFUSIÓN (broadcast) ---
# IDs de Discord (separados por comas) que pueden usar la "Difusión" del Creador
# de Anuncios: enviar mensajes/embeds a un servidor o a TODOS los del bot.
# Exclusivo de estas IDs (p. ej. la tuya y la de tu novia). Déjalo vacío para
# desactivar la función. Estas IDs pueden iniciar sesión aunque no sean staff.
BROADCAST_IDS=

# --- PAGOS (Stripe) ---
# Si dejas STRIPE_SECRET_KEY vacía, los pagos quedan DESACTIVADOS y el bot
# funciona igual (los planes se activan a mano con scripts/premium.js).
#
# Pasos en https://dashboard.stripe.com :
#   1) Developers -> API keys -> copia la "Secret key" (sk_test_... o sk_live_...).
#   2) Crea 2 productos ("Sokyo Pro" y "Sokyo Agencia") y, dentro de cada uno,
#      precios recurrentes mensual y anual (y opcional un precio "de pago único"
#      para la oferta de por vida). Copia el ID de cada precio (price_...).
#   3) Developers -> Webhooks -> "Add endpoint":
#        URL: https://TU-DOMINIO/api/billing/webhook   (en local usa `stripe listen`)
#        Eventos: checkout.session.completed, customer.subscription.created,
#                 customer.subscription.updated, customer.subscription.deleted
#      Copia el "Signing secret" (whsec_...) -> STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Price IDs del plan Pro (deja vacío el periodo que no ofrezcas).
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_PRO_LIFETIME=

# Price IDs del plan Agencia.
STRIPE_PRICE_AGENCY_MONTH=
STRIPE_PRICE_AGENCY_YEAR=
STRIPE_PRICE_AGENCY_LIFETIME=

# --- ASISTENTE IA EN TICKETS (opcional, de pago por uso) ---
# Si dejas ANTHROPIC_API_KEY vacía, el asistente IA queda DESACTIVADO y el bot
# funciona igual. Saca tu clave en https://console.anthropic.com (Settings -> API Keys).
# El uso de la IA tiene coste según el modelo; solo lo activas cuando quieras.
ANTHROPIC_API_KEY=
# Modelo a usar (opcional). Por defecto claude-haiku-4-5 (~0,005€ por uso, ideal
# para no llevarte sustos de coste). Para máxima calidad (y más coste) puedes
# poner claude-sonnet-4-6 o claude-opus-4-8.
# Hay cuota mensual de IA por servidor (Free 5 · Pro 150 · Agencia 1500 usos).
ANTHROPIC_MODEL=

# --- MÚSICA (Lavalink) ---
# El bot reproduce música conectándose a un servidor Lavalink que corre en este
# mismo PC. Arráncalo en una terminal aparte con:  npm run lavalink
# Estos valores por defecto funcionan tal cual; solo cámbialos si sabes lo que haces.
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=sokyolavalink

# --- SPOTIFY (opcional) ---
# Las URLs de Spotify (canciones, álbumes y playlists) funcionan gracias a un
# pequeño servidor de tokens incluido (carpeta spotify-tokener), que arranca
# SOLO junto a Lavalink con "npm run lavalink". No necesitas hacer nada más.
# Spotify solo aporta los TÍTULOS (100% legal); el audio sale de YouTube.
#
# --- OAuth de usuario Spotify (para conectar cuentas desde el panel) ---
# Permite a los usuarios del panel conectar su cuenta de Spotify para ver
# e importar sus playlists directamente. No es necesario para reproducir URLs.
#
# Pasos:
#   1) Ve a https://developer.spotify.com/dashboard y crea una app.
#   2) En "Redirect URIs" añade exactamente: http://localhost:3000/api/spotify/callback
#      (en producción usa: https://tu-dominio.com/api/spotify/callback)
#   3) Copia el Client ID y el Client Secret aquí abajo.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback

# --- SOPORTE ---
# Correo de contacto para el soporte por email (planes Free). Se expone en /api/estado.
SUPPORT_EMAIL=info@sokyo.studio

# Servidor de Discord de SOPORTE PRIORITARIO (Premium). Es privado: nunca se
# publica el invite, solo lo recibe por MD quien paga Premium. Para rellenar
# estas dos variables:
#   1) Crea un servidor vacío a mano e invita a tu bot (ver cabecera de
#      scripts/provisionar-soporte.js para el paso a paso).
#   2) Ejecuta: node scripts/provisionar-soporte.js <guildId>
#   3) Pega aquí los dos valores que te imprime el script.
SUPPORT_GUILD_ID=
SUPPORT_ROL_PREMIUM_ID=
