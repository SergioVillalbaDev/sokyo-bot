# =====================================================================
#  Configuración del bot Sokyo — copia este archivo a ".env" y rellénalo
# =====================================================================

# --- Obligatorias ---

# Cadena de conexión a MongoDB (local o Atlas: mongodb+srv://usuario:pass@cluster/SokyoDB)
MONGO_URI=mongodb://localhost:27017/sokyo

# Token del bot (Developer Portal -> tu app -> Bot -> Reset Token)
DISCORD_TOKEN=tu_token_de_discord

# --- API y panel web ---

# Puerto de la API que usa el panel web (por defecto 3000)
PORT=3000

# URL donde se abre el panel/portal web (adonde vuelve el login con Discord)
FRONTEND_URL=http://localhost:5173

# --- Login con Discord (panel del staff y portal de clientes) ---
# Developer Portal -> tu app -> OAuth2: copia el Client ID y el Client Secret y añade
# en "Redirects" la URL EXACTA de OAUTH_REDIRECT_URI.
DISCORD_CLIENT_ID=tu_client_id_de_discord
DISCORD_CLIENT_SECRET=tu_client_secret_de_discord
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Secreto con el que se firman las sesiones (cadena larga y aleatoria). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-este-secreto-de-sesion

# --- Opcionales ---

# Clave de administrador: permite entrar al panel con "Acceso de administrador con clave"
# (útil si aún no has configurado el login con Discord) y llamar a la API desde scripts
# con la cabecera "x-api-key". Déjala vacía para desactivar este acceso.
API_KEY=

# Registra los slash commands solo en este servidor (aparecen al instante; ideal para pruebas).
# Si se deja vacío se registran globalmente.
GUILD_ID_DEV=

# Zona horaria de las estadísticas por día (por defecto Europe/Madrid)
TZ=Europe/Madrid
