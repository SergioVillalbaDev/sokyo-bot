# --- Configuración del bot Sokyo ---

# Cadena de conexión a MongoDB
MONGO_URI=mongodb://localhost:27017/sokyo

# Token del bot de Discord (Developer Portal -> Bot -> Token)
DISCORD_TOKEN=tu_token_de_discord

# Puerto de la API y del panel web (por defecto 3000)
PORT=3000

# --- Login con Discord (panel de staff y portal de clientes) ---
# Developer Portal -> tu app -> OAuth2: copia el Client ID y el Client Secret,
# y añade la Redirect URI EXACTA (la de abajo) en la lista de "Redirects".
DISCORD_CLIENT_ID=tu_client_id_de_discord
DISCORD_CLIENT_SECRET=tu_client_secret_de_discord
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Dirección donde se abre el panel web (a donde se vuelve tras el login).
# Si el bot sirve el panel (npm run build), es la misma dirección que la API: http://IP:3000
# Si usas "npm run dev" del panel, sería http://localhost:5173
FRONTEND_URL=http://localhost:3000

# Secreto para firmar las sesiones (cualquier cadena larga y aleatoria):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-este-secreto-de-sesion

# --- IA (opcional) ---
# Clave de la API de Anthropic (https://console.anthropic.com). Sin ella el bot funciona igual, pero sin IA.
ANTHROPIC_API_KEY=
# Modelo a usar (por defecto claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5
# Usos de IA al mes por servidor (gratis / Premium)
# IA_LIMITE_GRATIS=30
# IA_LIMITE_PREMIUM=3000

# --- Desarrollo (opcional) ---
# Si pones el ID de un servidor, los comandos / se registran solo ahí y aparecen al instante.
# Déjalo vacío en producción (registro global, puede tardar hasta 1 hora la primera vez).
# DEV_GUILD_ID=
