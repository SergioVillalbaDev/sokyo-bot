node_modules/
.env
# Secreto de sesión generado automáticamente si no hay JWT_SECRET (ver utils/auth.js)
.jwt-secret
package-lock.json
dist/
# Builds temporales y estado del despliegue automático (deploy/deploy.sh)
sokyo-panelFRONTEND/dist-*/
.deploy-ok
.deploy-fallido
build/

# Artefactos de runtime: subidas y tarjetas de nivel generadas.
# Ignora todo el contenido de la carpeta pero mantiene la carpeta en el repo.
api/uploads/*
!api/uploads/.gitkeep

# Lavalink: el .jar (~96MB) y los plugins se descargan, no van al repo.
# La configuración (application.yml) SÍ se sube.
lavalink/Lavalink.jar
lavalink/plugins/
lavalink/logs/

# Copias de seguridad de la base de datos: llevan datos de clientes, NUNCA a git.
backups/