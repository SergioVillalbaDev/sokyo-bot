# ─────────────────────────────────────────────────────────────
# CLAVES SECRETAS. Copia este archivo como ".env" y rellénalo.
#   cp .env.example .env
# El archivo .env NO se sube a GitHub (está en .gitignore).
# ─────────────────────────────────────────────────────────────

# --- Binance TESTNET (dinero ficticio) ---
# Se crean gratis en https://testnet.binance.vision  (ver docs/06-paper-trading.md)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# --- Binance REAL (dinero de verdad) ---
# Crea la clave SOLO con permiso de "lectura" y "trading spot".
# NUNCA actives el permiso de retiro (withdraw).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Seguro extra: el modo real no arranca si esto no vale "si".
CONFIRMO_DINERO_REAL=no

# --- Telegram (opcional): avisos en el móvil ---
# Ver docs/08-avisos-telegram.md
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
